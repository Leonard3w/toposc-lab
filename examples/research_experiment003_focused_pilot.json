      "uncertainty": 0.2,
      "novelty": 0.1
    },
    "mutation_rates": {
      "multi_rewire_local": 0.75,
      "multi_rewire_explore": 0.25
    },
    "family_fraction": 0.5,
    "initialization_probability": 0.15,
    "quality_parent_probability": 0.7,
    "quality_parent_fraction": 0.25,
    "batch_novelty": true
  },
  "physics": {
    "adapter_id": "phase17.fixed-sites-chiral-p-wave.v1",
    "disorder_widths": [
      0.0,
