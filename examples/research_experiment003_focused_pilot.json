  "seed": 17301,
  "cycles": 10,
  "exact_budget": 1200,
  "candidate_budget": 20000,
  "pool_size": 96,
  "batch_size": 6,
  "checkpoint_every": 250,
  "retrain_every": 1,
  "wall_seconds": 7200,
  "concurrency": 1,
  "blas_threads": 1,
  "retry_limit": 1,
  "output_directory": "results/research/experiment003-focused-pilot",
  "geometry_space": "fixed_connectivity",
  "surrogate_model": "bootstrap_graph",
